# Database settings
DATABASE_URL=postgresql://user:password@localhost:5432/scorchtrack

# Security
SECRET_KEY=your-secret-key-replace-this-with-a-secure-random-string

# WhatsApp API settings
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_GROUP_ID=your-whatsapp-group-id
BOT_USER_ID=your-whatsapp-bot-user-id

# Green API
GREEN_API_INSTANCE_ID=your-green-api-instance-id
GREEN_API_ACCESS_TOKEN=your-green-api-access-token
GREEN_API_WEBHOOK_TOKEN=your-custom-webhook-token

# Google Gemini AI API
GEMINI_API_KEY=your-gemini-api-key

# Optional: Custom settings
ACCESS_TOKEN_EXPIRE_MINUTES=11520
